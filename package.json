{
  "name": "fourierlearn",
  "version": "0.1.0",
  "private": true,
  "description": "FourierLearn: narrated, animated O-Level maths lessons.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/run.mjs backend:dev",
    "dev:frontend": "node scripts/run.mjs frontend:dev",
    "doctor": "node scripts/doctor.mjs",
    "test": "npm run lint && npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/run.mjs backend:test",
    "test:frontend": "npm --prefix frontend run typecheck && npm --prefix frontend test",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "lint": "npm run lint:backend && npm run lint:frontend && prettier --check .",
    "lint:backend": "node scripts/run.mjs backend:lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "format": "node scripts/run.mjs backend:format && prettier --write .",
    "deps:lock": "node scripts/run.mjs deps:lock",
    "manim:smoke": "node scripts/run.mjs manim:smoke",
    "render": "node scripts/run.mjs render",
    "primitives:check": "node scripts/run.mjs primitives:check",
    "db:migrate": "node scripts/run.mjs db:migrate",
    "db:seed": "node scripts/run.mjs db:seed",
    "worker": "node scripts/run.mjs worker",
    "api:types": "node scripts/run.mjs api:types"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "prettier": "3.9.9"
  }
}
