{
  "name": "fourierlearn",
  "version": "0.1.0",
  "private": true,
  "description": "FourierLearn: narrated, animated O-Level maths lessons (project skeleton).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/run.mjs backend:dev",
    "dev:frontend": "node scripts/run.mjs frontend:dev",
    "doctor": "node scripts/doctor.mjs",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/run.mjs backend:test",
    "test:frontend": "npm --prefix frontend run lint && npm --prefix frontend run typecheck",
    "lint:backend": "node scripts/run.mjs backend:lint",
    "manim:smoke": "node scripts/run.mjs manim:smoke",
    "db:migrate": "node scripts/run.mjs db:migrate"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
