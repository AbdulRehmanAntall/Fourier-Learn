      "primitive_id": "FunctionGraph",
      "video": "beats/0.mp4",
      "duration_s": 24.5,
      "steps": [
        {
          "start_s": 0.0,
          "end_s": 4.8,
          "narration": "First, the axes. The x axis goes across, and the y axis goes up."
        },
        {
          "start_s": 5.4,
          "end_s": 10.6,
          "narration": "The equation is y equals 2 x. Each y value is double its x value."
        },
        {
          "start_s": 11.2,
          "end_s": 15.1,
          "narration": "Now we draw the graph from left to right. It is a straight line."
        },
        {
          "start_s": 15.7,
          "end_s": 19.267,
          "narration": "Here is the point 1, 2. When x is 1, y is 2."
        },
        {
          "start_s": 19.867,
          "end_s": 23.9,
          "narration": "And here is the point 4, 8. When x is 4, y is 8."
        }
      ],
      "chips": [
        {
          "term": "graph",
          "start_s": 0.0,
          "end_s": 24.5
        },
        {
          "term": "coordinates",
          "start_s": 0.0,
          "end_s": 24.5
        }
      ],
