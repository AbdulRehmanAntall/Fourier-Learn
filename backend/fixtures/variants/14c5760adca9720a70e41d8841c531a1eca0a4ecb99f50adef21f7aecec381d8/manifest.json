    },
    {
      "index": 1,
      "primitive_id": "GradientTriangle",
      "video": "beats/1.mp4",
      "duration_s": 29.867,
      "steps": [
        {
          "start_s": 0.0,
          "end_s": 3.633,
          "narration": "Let's draw the axes again, to measure how steep the line is."
        },
        {
          "start_s": 4.233,
          "end_s": 6.367,
          "narration": "Here is our first point, 1, 2."
        },
        {
          "start_s": 6.967,
          "end_s": 9.067,
          "narration": "And our second point, 4, 8."
        },
        {
          "start_s": 9.667,
          "end_s": 12.067,
          "narration": "This straight line goes through both points."
        },
        {
          "start_s": 12.667,
          "end_s": 17.067,
          "narration": "The run is how far we move across. From 1 to 4 is 3 across."
        },
        {
          "start_s": 17.667,
          "end_s": 21.633,
          "narration": "The rise is how far we move up. From 2 to 8 is 6 up."
        },
        {
          "start_s": 22.233,
          "end_s": 29.267,
          "narration": "The gradient tells us how steep a line is. It is the rise divided by the run: 6 over 3, which is 2."
        }
      ],
      "chips": [
        {
