    {
      "index": 2,
      "primitive_id": "EquationTransform",
      "video": "beats/2.mp4",
      "duration_s": 16.333,
      "steps": [
        {
          "start_s": 0.0,
          "end_s": 4.933,
          "narration": "Here is the same working with numbers: 8 minus 2, over 4 minus 1."
        },
        {
          "start_s": 5.533,
          "end_s": 10.333,
          "narration": "8 minus 2 is 6, and 4 minus 1 is 3, so we have 6 over 3."
        },
        {
          "start_s": 10.933,
          "end_s": 15.733,
          "narration": "6 divided by 3 is 2. The line goes up 2 for every 1 across."
        }
      ],
