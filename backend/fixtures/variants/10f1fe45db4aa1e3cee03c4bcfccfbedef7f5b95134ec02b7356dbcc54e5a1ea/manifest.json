      "index": 0,
      "primitive_id": "FunctionGraph",
      "video": "beats/0.mp4",
      "duration_s": 15.567,
      "steps": [
        {
          "start_s": 0.0,
          "end_s": 5.267,
          "narration": "Here are the x and y axes, with the equation of our line at the top: y equals 2 x."
        },
        {
          "start_s": 5.267,
          "end_s": 10.333,
          "narration": "Drawing the graph from left to right gives a straight line through the origin, rising as it goes."
        },
        {
          "start_s": 10.333,
          "end_s": 15.567,
          "narration": "Two points on this line are 1, 2 and 4, 8. We will use them to measure how steep the line is."
        }
      ],
      "chips": [
        {
          "term": "graph",
          "start_s": 0.0,
          "end_s": 15.567
        },
        {
          "term": "coordinates",
          "start_s": 0.0,
          "end_s": 15.567
        }
      ],
