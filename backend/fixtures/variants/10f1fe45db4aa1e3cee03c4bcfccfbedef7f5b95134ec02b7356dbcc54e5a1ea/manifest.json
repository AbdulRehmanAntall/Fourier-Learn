        12
      ]
    },
    {
      "index": 1,
      "primitive_id": "GradientTriangle",
      "video": "beats/1.mp4",
      "duration_s": 17.1,
      "steps": [
        {
          "start_s": 0.0,
          "end_s": 3.0,
          "narration": "Let's look at those two points again on a fresh pair of axes."
        },
        {
          "start_s": 3.0,
          "end_s": 5.7,
          "narration": "This is the straight line that passes through both of them."
        },
        {
          "start_s": 5.7,
          "end_s": 12.633,
          "narration": "From the first point to the second, the line runs 3 across and rises 6 up. Together they make a right-angled triangle."
        },
        {
          "start_s": 12.633,
          "end_s": 17.1,
          "narration": "The gradient is the rise divided by the run: 6 over 3, which is 2."
        }
      ],
      "chips": [
        {
          "term": "gradient",
          "start_s": 0.0,
          "end_s": 17.1
        },
        {
          "term": "rise",
          "start_s": 0.0,
          "end_s": 17.1
        },
        {
