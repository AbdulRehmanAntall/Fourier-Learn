    },
    {
      "index": 2,
      "primitive_id": "EquationTransform",
      "video": "beats/2.mp4",
      "duration_s": 14.767,
      "steps": [
        {
          "start_s": 0.0,
          "end_s": 5.233,
          "narration": "We can write the same calculation with the coordinates: 8 minus 2, over 4 minus 1."
        },
        {
          "start_s": 5.233,
          "end_s": 8.833,
          "narration": "The top is 6 and the bottom is 3, so this is 6 over 3."
        },
        {
          "start_s": 8.833,
          "end_s": 14.767,
          "narration": "That simplifies to 2. So the gradient of the line is 2, which means it goes up 2 for every 1 across."
        }
      ],
      "chips": [
