# Copy to .env (npm run setup does this for you). Never commit .env.

# Native dev: Postgres from `docker compose up -d db` is exposed on host port 5433.
# (Inside Docker Compose this is overridden to point at the `db` service.)
DATABASE_URL=postgresql+psycopg://fourierlearn:fourierlearn@localhost:5433/fourierlearn

# Comma-separated list of origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where rendered videos/audio go. Relative paths are relative to backend/.
MEDIA_DIR=media

# Not used yet.
LLM_API_KEY=
# Not used yet.
TTS_API_KEY=
