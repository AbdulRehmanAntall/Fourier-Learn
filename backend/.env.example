# Copy to .env (npm run setup does this for you). Never commit .env.

# Native dev: Postgres from `docker compose up -d db` is exposed on host port 5433.
# (Inside Docker Compose this is overridden to point at the `db` service.)
DATABASE_URL=postgresql+psycopg://fourierlearn:fourierlearn@localhost:5433/fourierlearn

# Comma-separated list of origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where rendered videos/audio go. Relative paths are relative to backend/.
MEDIA_DIR=media

# Narration voice: kokoro (local neural voice; model downloaded to TTS_MODEL_DIR on first use),
# espeak (local espeak-ng, must be installed) or fake (silent, for tests).
TTS_PROVIDER=kokoro
TTS_MODEL_DIR=models/kokoro
# Video quality of rendered lesson beats: 480p30, 720p30 or 1080p30.
RENDER_QUALITY=720p30
# Beats rendered in parallel; 0 = one per CPU core.
RENDER_WORKERS=0

# Phase 2: serve the API from the in-memory stub with sample data (docs/frontend.md §8).
STUB_API=true
# Delay (ms) added to every stub response, so loading states are visible. 0 to turn off.
STUB_LATENCY_MS=300
# Send the session cookie over HTTPS only; turn on for any deployment served over HTTPS.
SESSION_COOKIE_SECURE=false

# Not used yet.
LLM_API_KEY=
# Not used yet.
TTS_API_KEY=
