# Root settings: ports for native dev (npm run dev) and Docker Compose.
# Copy to .env (npm run setup does this). Never commit .env.
# If you change a port, also update backend/.env (DATABASE_URL, CORS_ORIGINS)
# and frontend/.env (BACKEND_URL) to match.

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5433

# Local development credentials for the Postgres container.
POSTGRES_USER=fourierlearn
POSTGRES_PASSWORD=fourierlearn
POSTGRES_DB=fourierlearn

# Docker only: set to true if hot reload misses file changes (e.g. Windows repo outside WSL2).
DOCKER_FILE_POLLING=false
