# Normalise line endings: LF in the repo and in working copies, on every OS.
* text=auto eol=lf

# Files that run inside Linux containers must always be LF.
Dockerfile text eol=lf
*.sh text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
